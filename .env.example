# =============================================================================
# ComplianceIQ — Environment Configuration
# Copy this file to .env and fill in your values. Never commit .env to git.
# =============================================================================

# Server port (default: 3000)
PORT=3000

# =============================================================================
# AWS Bedrock — AI Engine (Claude 3.5 Sonnet)
# =============================================================================
# Option A: Static IAM credentials (local development only)
# Get these from AWS Console > IAM > Users > Security credentials
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Option B: Temporary session credentials (for assumed roles / SSO)
# AWS_SESSION_TOKEN=your_session_token_here

# Bedrock model ID — Claude 3.5 Sonnet v2 (default)
# Other options: anthropic.claude-3-5-haiku-20241022-v1:0  |  amazon.titan-text-premier-v1:0
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0

# NOTE: If running on an EC2 instance, ECS task, or Lambda with an IAM role attached,
# you can omit AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY — the SDK uses the
# instance/task role automatically via the default credential provider chain.

# =============================================================================
# Tavily Search API — Live Regulatory News & Chat Web Search
# Replaces Google Search Grounding. Free tier available at https://tavily.com
# Without this key the app works fine but news refresh and chat search are disabled.
# =============================================================================
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# =============================================================================
# App URL (used for self-referential links and OAuth callbacks if added later)
# =============================================================================
APP_URL=http://localhost:3000
